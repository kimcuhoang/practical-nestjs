{
  "name": "practical-nestjs",
  "version": "0.0.1",
  "description": "",
  "author": "Kim-CH",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/kimcuhoang/practical-nestjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "nest": "./node_modules/.bin/nest",
    "build": "yarn nest build",
    "typeorm-ext": "ts-node ./node_modules/typeorm-extension/bin/cli.cjs -d src/typeorm.datasource.ts",
    "db:create": "yarn typeorm-ext db:create --synchronize no",
    "db:drop": "yarn typeorm-ext db:drop",
    "typeorm": "typeorm-ts-node-commonjs -d src/typeorm.datasource.ts",
    "typeorm:create-migration": "typeorm-ts-node-commonjs migration:create",
    "typeorm:run-migrations": "yarn typeorm migration:run",
    "typeorm:generate-migration": "yarn typeorm migration:generate",
    "typeorm:revert-migration": "yarn typeorm migration:revert",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "yarn nest start",
    "start:dev": "yarn nest start --watch",
    "start:debug": "yarn nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:e2e": "TESTCONTAINERS_RYUK_DISABLED=true node --no-addons ./node_modules/.bin/jest --runInBand --config ./test/jest.config.ts",
    "test:watch": "yarn test:e2e --watch",
    "test:cov": "yarn test:e2e --coverage",
    "test:e2e:linux": "yarn test:e2e --shard=1/2 & yarn test --shard=2/2"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^10.2.7",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/typeorm": "^10.0.2",
    "@redis/client": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^6.0.0",
    "moment": "^2.30.1",
    "nestjs-i18n": "10.5.0",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "solclientjs": "^10.17.1",
    "typeorm": "^0.3.20",
    "typeorm-extension": "^3.6.3",
    "typeorm-naming-strategies": "^4.1.0",
    "typeorm-transactional": "^0.5.0",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@testcontainers/redis": "^10.16.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "testcontainers": "^10.17.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "webpack": "^5.87.0"
  },
  "packageManager": "yarn@1.22.22+sha256.c17d3797fb9a9115bf375e31bfd30058cac6bc9c3b8807a3d8cb2094794b51ca",
  "resolutions": {
    "glob": "^11.0.0",
    "locter": "2.1.6"
  }
}
